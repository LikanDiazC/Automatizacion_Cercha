# Copy this file to .env and fill in real values.
# NEVER commit .env to source control.

# Admin credentials (required for DELETE /inventario and other protected endpoints)
# OpenAI — obligatorio para el motor de IA
LLM_API_KEY=sk-proj-tu-key-aqui
LLM_MODEL=gpt-4o

# Base de datos — SQLite para dev, PostgreSQL para producción
DATABASE_URL=sqlite:///./mrp_muebles.db

# Admin
ADMIN_TOKEN=Admin2046
ADMIN_USER=Admin2046

# Scraper
SCRAPER_DELAY_MIN=2.0
SCRAPER_DELAY_MAX=5.0

# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173,https://suplee.pages.dev

# Pagination
DEFAULT_PAGE_SIZE=100
MAX_PAGE_SIZE=500
