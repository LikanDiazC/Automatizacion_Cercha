# Copy this file to .env and fill in real values.
# NEVER commit .env to source control.

# Admin credentials (required for DELETE /inventario and other protected endpoints)
ADMIN_USER=your_admin_username_here
ADMIN_TOKEN=your_strong_random_token_here

# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173,https://suplee.pages.dev

# Pagination
DEFAULT_PAGE_SIZE=100
MAX_PAGE_SIZE=500
