# Admin credentials (required for DELETE /inventario and other protected endpoints)

LLM_API_KEY=AIzaSyCiv9IoILVJ65pY-vTyf6MK0aOWk02yMgY
LLM_PROVIDER=google
LLM_MODEL=gemini-1.5-flash

# Base de datos — SQLite para dev, PostgreSQL para producción
